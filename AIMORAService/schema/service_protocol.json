  "error_codes": [
    "AUTHENTICATION_REQUIRED",
    "AUTHENTICATION_FAILED",
    "PROTOCOL_VERSION_UNSUPPORTED",
    "INVALID_REQUEST",
    "METHOD_NOT_FOUND",
    "FRAME_INVALID",
    "FRAME_TOO_LARGE",
    "PATH_NOT_ALLOWED",
    "RESOURCE_NOT_FOUND",
    "RESOURCE_TOO_LARGE",
    "REQUEST_CANCELLED",
    "WORKER_UNAVAILABLE",
    "WORKER_LIMIT_REACHED",
    "WORKER_NOT_FOUND",
